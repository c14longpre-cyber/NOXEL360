{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/learn/technologies.html",
      "destination": "/learn/development.html",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/pricing/tiers/:path*",
      "destination": "/pricing/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://noxel360-production-aa57.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
